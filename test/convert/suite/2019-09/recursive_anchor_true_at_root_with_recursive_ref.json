  },
  "result": {
    "draft4": null,
    "draft6": null,
    "draft7": null,
    "2019-09": null,
    "2020-12": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/strict-tree",
      "$dynamicAnchor": "meta",
      "$ref": "https://example.com/tree",
      "unevaluatedProperties": false,
      "$defs": {
        "tree": {
          "$id": "https://example.com/tree",
          "type": "object",
          "properties": {
            "data": true,
            "children": {
              "type": "array",
              "items": { "$dynamicRef": "#meta" }
