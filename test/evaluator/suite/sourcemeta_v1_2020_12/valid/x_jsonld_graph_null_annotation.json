      [ "Annotation", "/x-jsonld-graph", "#/x-jsonld-graph", "" ],
      [ "Annotation", "/x-jsonld-override", "#/x-jsonld-override", "" ]
    ],
    "post": [
      [ true, "Annotation", "/x-jsonld-graph", "#/x-jsonld-graph", "", null ],
      [ true, "Annotation", "/x-jsonld-override", "#/x-jsonld-override", "", true ]
    ],
    "descriptions": [
      "The value was not expected to be wrapped in a JSON-LD named graph",
      "The sibling JSON-LD annotations were expected to override the nested annotations they shadow"
    ]
