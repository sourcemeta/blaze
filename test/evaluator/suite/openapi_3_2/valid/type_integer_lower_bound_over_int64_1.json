{
  "schema": {
    "$schema": "https://spec.openapis.org/oas/3.2/dialect/2025-09-17",
    "type": "integer",
    "minimum": 0
  },
  "instance": 12345678901234567890123456789012345678901234,
  "valid": true,
  "fast": {
    "pre": [
      [ "AssertionTypeIntegerLowerBound", "/minimum", "#/minimum", "" ]
    ],
    "post": [
      [ true, "AssertionTypeIntegerLowerBound", "/minimum", "#/minimum", "" ]
    ],
    "descriptions": [
      "The value was expected to be an integer above the given minimum"
    ]
  },
  "exhaustive": {
    "pre": [
      [ "AssertionType", "/type", "#/type", "" ],
      [ "AssertionGreaterEqual", "/minimum", "#/minimum", "" ]
    ],
    "post": [
      [ true, "AssertionType", "/type", "#/type", "" ],
      [ true, "AssertionGreaterEqual", "/minimum", "#/minimum", "" ]
    ],
    "descriptions": [
      "The value was expected to be of type integer",
      "The integer value 12345678901234567890123456789012345678901234 was expected to be greater than or equal to the integer 0"
    ]
  }
}
