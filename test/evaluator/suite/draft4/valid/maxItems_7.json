      [ "AssertionTypeStrict", "/type", "#/type", "" ]
    ],
    "post": [
      [ true, "AssertionArraySizeLess", "/maxItems", "#/maxItems", "" ],
      [ true, "AssertionArraySizeGreater", "/minItems", "#/minItems", "" ],
      [ true, "AssertionTypeStrict", "/type", "#/type", "" ]
