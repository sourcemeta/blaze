{
  "comment": "The dialect this resolves is reduced to its vocabulary declarations, which are what make the extension keywords compile",
  "schema": {
    "$schema": "tag:sourcemeta.com,2026:extension/v1/2019-09",
    "format": "uri",
    "x-format-assertion": true
  },
  "resolve": {
    "tag:sourcemeta.com,2026:extension/v1/2019-09": {
      "$id": "tag:sourcemeta.com,2026:extension/v1/2019-09",
      "$schema": "https://json-schema.org/draft/2019-09/schema",
      "$vocabulary": {
        "https://json-schema.org/draft/2019-09/vocab/core": true,
        "https://json-schema.org/draft/2019-09/vocab/applicator": true,
        "https://json-schema.org/draft/2019-09/vocab/validation": true,
        "https://json-schema.org/draft/2019-09/vocab/meta-data": true,
        "https://json-schema.org/draft/2019-09/vocab/format": false,
        "https://json-schema.org/draft/2019-09/vocab/content": true,
        "tag:sourcemeta.com,2026:extension/v1": true
      }
    }
  },
  "instance": "https://example.com",
  "valid": true,
  "fast": {
    "pre": [
