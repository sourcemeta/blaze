    ]
  },
  "exhaustive": {
    "pre": [
      [ "LogicalConditionEvaluate", "/if", "#/if", "" ],
      [ "ControlJump", "/if/$ref", "#/if/$ref", "" ],
      [ "LogicalWhenType", "/if/$ref/properties", "#/$defs/common/properties", "" ],
      [ "ControlJump", "/then/$ref", "#/then/$ref", "" ],
      [ "LogicalWhenType", "/then/$ref/properties", "#/$defs/common/properties", "" ],
      [ "LoopPropertiesUnevaluated", "/unevaluatedProperties", "#/unevaluatedProperties", "" ],
      [ "AssertionFail", "/unevaluatedProperties", "#/unevaluatedProperties", "/extra" ]
    ],
    "post": [
      [ true, "LogicalWhenType", "/if/$ref/properties", "#/$defs/common/properties", "" ],
      [ true, "ControlJump", "/if/$ref", "#/if/$ref", "" ],
      [ true, "LogicalWhenType", "/then/$ref/properties", "#/$defs/common/properties", "" ],
      [ true, "ControlJump", "/then/$ref", "#/then/$ref", "" ],
      [ true, "LogicalConditionEvaluate", "/if", "#/if", "" ],
      [ false, "AssertionFail", "/unevaluatedProperties", "#/unevaluatedProperties", "/extra" ],
      [ false, "LoopPropertiesUnevaluated", "/unevaluatedProperties", "#/unevaluatedProperties", "" ]
    ],
    "descriptions": [
      "The object value was expected to validate against the single defined property subschema",
