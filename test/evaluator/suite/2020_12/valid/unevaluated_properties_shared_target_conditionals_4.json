{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": { "common": { "properties": { "allowed": { "type": "integer" } } } },
    "if": { "$ref": "#/$defs/common" },
    "then": { "$ref": "#/$defs/common" },
    "else": { "$ref": "#/$defs/common" },
    "unevaluatedProperties": false
  },
  "instance": { "extra": 1 },
  "valid": false,
  "fast": {
    "pre": [
      [ "LogicalConditionEvaluate", "/if", "#/if", "" ],
      [ "LoopPropertiesUnevaluated", "/unevaluatedProperties", "#/unevaluatedProperties", "" ],
      [ "AssertionFail", "/unevaluatedProperties", "#/unevaluatedProperties", "/extra" ]
    ],
    "post": [
      [ true, "LogicalConditionEvaluate", "/if", "#/if", "" ],
      [ false, "AssertionFail", "/unevaluatedProperties", "#/unevaluatedProperties", "/extra" ],
      [ false, "LoopPropertiesUnevaluated", "/unevaluatedProperties", "#/unevaluatedProperties", "" ]
    ],
    "descriptions": [
      "The object value was expected to validate against the given conditional",
      "The object value was not expected to define the property \"extra\"",
