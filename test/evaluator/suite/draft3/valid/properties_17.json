{
  "schema": {
    "$schema": "http://json-schema.org/draft-03/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "foo": { "type": "string", "required": true },
      "bar": { "type": "array", "required": true },
      "baz": { "type": "object", "required": true }
    }
  },
  "instance": "baz",
  "valid": false,
  "fast": {
    "pre": [
      [ "AssertionDefinesExactlyStrictHash3", "/properties", "#/properties", "" ]
    ],
    "post": [
      [ false, "AssertionDefinesExactlyStrictHash3", "/properties", "#/properties", "" ]
    ],
    "descriptions": [
      "The value was expected to be an object that only defines the 3 given properties"
    ]
  },
  "exhaustive": {
    "pre": [
      [ "AssertionTypeStrict", "/type", "#/type", "" ]
    ],
    "post": [
      [ false, "AssertionTypeStrict", "/type", "#/type", "" ]
    ],
    "descriptions": [
      "The value was expected to be of type object but it was of type string"
    ]
  }
}
