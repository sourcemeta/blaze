{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "gift"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "required": [
      "note"
    ],
    "properties": {
      "note": {
        "type": "string"
      }
    }
  },
  "else": {
    "required": [
      "plain"
    ],
    "properties": {
      "plain": {
        "type": "boolean"
      }
    }
  }
}
