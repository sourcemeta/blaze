{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "gift"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "properties": {
      "note": {
        "type": "string"
      }
    },
    "required": [
      "note"
    ]
  }
}
