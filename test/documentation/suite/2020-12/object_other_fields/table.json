{
  "$schema": "tag:sourcemeta.com,2026:table-format/2",
  "title": "Schema",
  "language": "https://json-schema.org/draft/2020-12/schema",
  "root": {
    "kind": "object",
    "patternFields": [
      {
        "pattern": "^x-",
        "value": {
          "kind": "string"
        }
      }
    ],
    "otherFields": {
      "kind": "integer"
    },
    "keys": {
      "kind": "string",
      "pattern": "^[a-z]",
      "otherTypesAllowed": true
    },
    "fieldCount": {
      "min": 1,
      "max": 4
    }
  }
}
