{
  "name": "drop_allof_empty_schemas",
  "match": {
    "all": [
      {
        "call": {
          "name": "schema:in-vocabulary",
          "args": [
            "https://json-schema.org/draft/2020-12/vocab/applicator",
            "https://json-schema.org/draft/2019-09/vocab/applicator",
            "http://json-schema.org/draft-07/schema#",
            "http://json-schema.org/draft-06/schema#",
            "http://json-schema.org/draft-04/schema#"
          ]
        }
      },
      {
        "type": "object"
      },
      {
        "member": {
          "key": "allOf",
          "match": {
            "all": [
              {
                "type": "array"
              },
              {
                "not": {
                  "empty": true
                }
              },
              {
                "some-item": {
                  "any": [
                    {
                      "const": true
                    },
                    {
                      "all": [
                        {
                          "type": "object"
                        },
                        {
                          "empty": true
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ]
  },
  "build": [
    {
      "erase": {
        "from": "/allOf",
        "items": {
          "any": [
            {
              "const": true
            },
            {
              "all": [
                {
                  "type": "object"
                },
                {
                  "empty": true
                }
              ]
            }
          ]
        }
      },
      "prune-empty": true
    }
  ]
}
