        "to": {
          "call": {
            "name": "convert:shadow-pointer",
            "args": [
              "$self",
              "$key"
            ]
          }
        }
      },
      "if": {
        "has": "$ref"
      }
    },
    {
      "move": {
        "from": "/$id",
        "to": "/$anchor"
      },
      "if": {
        "all": [
          {
            "has": "$id"
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "fragment-only"
              ]
            }
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "plain-name"
              ]
            }
          }
        ]
      }
    },
    {
      "set": {
        "$anchor": {
          "call": {
            "name": "convert:id-fragment",
            "args": [
              "$self"
            ]
          }
        }
      },
      "if": {
        "all": [
          {
            "has": "$id"
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "fragment-only"
              ]
            }
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "plain-name"
              ]
            }
          }
        ]
      }
    },
    {
      "erase": "$id",
      "if": {
        "all": [
          {
            "has": "$id"
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "fragment-only"
              ]
            }
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "empty"
              ]
            }
          }
        ]
      }
    },
    {
      "set": {
        "$id": {
          "call": {
            "name": "convert:id-without-fragment",
            "args": [
              "$self"
            ]
          }
        }
      },
      "if": {
        "all": [
          {
            "has": "$id"
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "present"
              ]
            }
          },
          {
            "not": {
              "call": {
                "name": "convert:id-fragment-shape",
                "args": [
                  "$term",
                  "fragment-only"
                ]
              }
            }
          },
          {
            "any": [
              {
                "call": {
                  "name": "convert:id-fragment-shape",
                  "args": [
                    "$term",
                    "plain-name"
                  ]
                }
              },
              {
                "call": {
                  "name": "convert:id-fragment-shape",
                  "args": [
                    "$term",
                    "empty"
                  ]
                }
              }
            ]
          },
          {
            "call": {
              "name": "convert:id-fragment-shape",
              "args": [
                "$term",
                "recomposes"
              ]
            }
          }
        ]
      }
    },
    {
      "set": {
        "$anchor": {
          "call": {
            "name": "convert:id-fragment",
            "args": [
              "$self"
            ]
          }
        }
      },
      "if": {
        "all": [
          {
            "all": [
              {
                "has": "$id"
              },
              {
                "call": {
                  "name": "convert:id-fragment-shape",
                  "args": [
                    "$term",
                    "present"
                  ]
                }
              },
              {
                "not": {
                  "call": {
                    "name": "convert:id-fragment-shape",
                    "args": [
                      "$term",
                      "fragment-only"
                    ]
                  }
                }
              },
              {
                "any": [
                  {
                    "call": {
                      "name": "convert:id-fragment-shape",
                      "args": [
                        "$term",
                        "plain-name"
                      ]
                    }
                  },
                  {
                    "call": {
                      "name": "convert:id-fragment-shape",
                      "args": [
                        "$term",
                        "empty"
                      ]
                    }
                  }
                ]
              },
              {
                "call": {
                  "name": "convert:id-fragment-shape",
                  "args": [
                    "$term",
                    "recomposes"
                  ]
                }
              }
            ]
          },
          {
            "call": {
