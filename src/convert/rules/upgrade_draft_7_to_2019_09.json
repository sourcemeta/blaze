          {
            "when": {
              "type": "array"
            },
            "to": "/dependentRequired/$key"
          }
        ]
      },
      "if": {
        "all": [
          {
            "member": {
              "key": "dependencies",
              "match": {
                "type": "object",
                "members": {
                  "type": [
                    "array",
                    "object",
                    "boolean"
                  ]
                }
              }
            }
          },
          {
            "not": {
              "has": [
                "dependentRequired"
              ]
            }
          },
          {
            "not": {
              "has": [
                "dependentSchemas"
              ]
            }
          }
        ]
