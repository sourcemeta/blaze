{
  "name": "upgrade_draft_7_to_2019_09",
  "match": {
    "all": [
      {
        "call": {
          "name": "schema:in-vocabulary",
          "args": [
            "http://json-schema.org/draft-07/schema#"
          ]
        }
      },
      {
        "type": "object"
      },
      {
        "any": [
          {
            "ref": "at-dialect-declaration"
          },
          {
            "all": [
              {
                "member": {
