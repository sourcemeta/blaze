                    "dependentRequired"
                  ]
                }
              },
              {
                "not": {
                  "has": [
                    "dependentSchemas"
                  ]
                }
              }
            ]
          },
          {
            "all": [
              {
                "has": "$ref"
              },
              {
                "some-member": {
                  "key": {
                    "all": [
                      {
                        "not": {
                          "enum": [
                            "$ref",
                            "$schema",
                            "title",
                            "description",
                            "default",
                            "examples",
                            "$comment",
                            "readOnly",
                            "writeOnly",
                            "deprecated",
                            "contentMediaType",
                            "contentEncoding"
                          ]
                        }
                      },
                      {
                        "not": {
                          "call": {
                            "name": "convert:starts-with",
                            "args": [
                              "$term",
                              "x-"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          {
            "has": "$anchor"
          },
          {
            "has": "$recursiveAnchor"
          },
          {
            "has": "$recursiveRef"
          },
          {
            "has": "$vocabulary"
          },
          {
            "has": "$defs"
          },
          {
            "has": "dependentSchemas"
          },
          {
            "has": "dependentRequired"
          },
          {
            "has": "unevaluatedItems"
          },
          {
            "has": "unevaluatedProperties"
          },
          {
            "has": "maxContains"
          },
          {
            "has": "minContains"
          },
          {
            "has": "contentSchema"
          },
          {
            "all": [
              {
                "has": "deprecated"
              },
              {
                "any": [
                  {
                    "not": {
                      "call": {
                        "name": "convert:setting",
                        "args": [
                          "from-openapi-3-0"
                        ]
                      }
                    }
                  },
                  {
                    "member": {
                      "key": "deprecated",
                      "match": {
                        "not": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
