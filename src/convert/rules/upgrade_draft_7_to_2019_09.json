              "call": {
                "name": "convert:shadow-pointer",
                "args": [
                  "$self",
                  "dependentSchemas"
                ]
              }
            },
            "optional": true
          }
        },
        {
          "move": {
            "from": "/dependentRequired",
            "to": {
              "call": {
                "name": "convert:shadow-pointer",
                "args": [
                  "$self",
                  "dependentRequired"
                ]
              }
            },
            "optional": true
          }
        },
        {
          "move": {
            "from": "/unevaluatedItems",
