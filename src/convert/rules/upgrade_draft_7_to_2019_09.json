                }
              },
              {
                "any": [
                  {
                    "call": {
                      "name": "convert:id-fragment-shape",
                      "args": [
                        "$term",
                        "empty"
                      ]
                    }
                  },
                  {
                    "call": {
                      "name": "convert:id-fragment-shape",
                      "args": [
                        "$term",
                        "plain-name"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "all": [
              {
                "member": {
                  "key": "dependencies",
                  "match": {
                    "type": "object",
                    "members": {
                      "type": [
                        "array",
                        "object",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              {
                "not": {
