                  "not": {
                    "call": {
                      "name": "convert:setting",
                      "args": [
                        "from-openapi-3-0"
                      ]
                    }
                  }
                },
                {
                  "not": {
                    "type": "boolean"
                  }
                }
              ]
            }
          }
        }
      ],
      "if": {
        "call": {
          "name": "convert:promoted-keyword-is-author-data",
          "args": [
            "https://json-schema.org/draft/2019-09/schema"
          ]
        }
      }
    },
    {
      "move": {
        "keys": {
          "not": {
