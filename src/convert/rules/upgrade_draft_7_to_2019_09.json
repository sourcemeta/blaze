              "call": {
                "name": "convert:shadow-pointer",
                "args": [
                  "$self",
                  "unevaluatedItems"
                ]
              }
            },
            "optional": true
          }
        },
        {
          "move": {
            "from": "/unevaluatedProperties",
            "to": {
              "call": {
                "name": "convert:shadow-pointer",
                "args": [
                  "$self",
                  "unevaluatedProperties"
                ]
              }
            },
            "optional": true
          }
        },
        {
          "move": {
            "from": "/maxContains",
            "to": {
              "call": {
                "name": "convert:shadow-pointer",
                "args": [
                  "$self",
                  "maxContains"
                ]
              }
            },
            "optional": true
          }
        },
        {
          "move": {
            "from": "/minContains",
            "to": {
              "call": {
                "name": "convert:shadow-pointer",
                "args": [
                  "$self",
                  "minContains"
                ]
              }
            },
            "optional": true
          }
        },
        {
          "move": {
