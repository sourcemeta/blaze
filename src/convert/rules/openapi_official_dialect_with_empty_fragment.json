{
  "name": "openapi_official_dialect_with_empty_fragment",
  "match": {
    "all": [
      {
        "type": "object"
      },
      {
        "member": {
          "key": "$schema",
          "bind": "$dialect",
          "match": {
            "enum": [
              "https://spec.openapis.org/oas/3.1/dialect/base#",
              "https://spec.openapis.org/oas/3.2/dialect/2025-09-17#"
            ]
          }
        }
      }
    ]
  },
  "build": [
    {
      "set": {
        "$schema": {
          "lookup": {
            "key": "$dialect",
            "table": {
              "https://spec.openapis.org/oas/3.1/dialect/base#": "https://spec.openapis.org/oas/3.1/dialect/base",
              "https://spec.openapis.org/oas/3.2/dialect/2025-09-17#": "https://spec.openapis.org/oas/3.2/dialect/2025-09-17"
            }
          }
        }
      }
    }
  ]
}
