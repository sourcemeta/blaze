{
  "name": "prefix_promoted_openapi_3_1_keywords",
  "match": {
    "all": [
      {
        "call": {
          "name": "schema:in-vocabulary",
          "args": [
            "https://json-schema.org/draft/2020-12/vocab/core"
          ]
        }
      },
      {
        "not": {
          "call": {
            "name": "schema:in-vocabulary",
            "args": [
              "https://spec.openapis.org/oas/3.1/vocab/base",
              "https://spec.openapis.org/oas/3.2/vocab/base"
            ]
          }
        }
      },
      {
        "type": "object"
      },
      {
        "call": {
          "name": "convert:promoted-keyword-is-author-data",
          "args": [
            "https://spec.openapis.org/oas/3.1/dialect/base"
          ]
        }
      },
      {
        "any": [
          {
            "member": {
              "key": "discriminator",
              "match": {
                "not": {
                  "type": "object"
                }
              }
            }
          },
          {
            "member": {
              "key": "externalDocs",
              "match": {
                "not": {
                  "type": "object"
                }
              }
            }
          },
          {
            "member": {
              "key": "xml",
              "match": {
                "not": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "build": [
    {
      "move": {
        "from": "/discriminator",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-discriminator"
            ]
          }
        },
        "optional": true,
        "when": {
          "not": {
            "type": "object"
          }
        }
      }
    },
    {
      "move": {
        "from": "/externalDocs",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-externalDocs"
            ]
          }
        },
        "optional": true,
        "when": {
          "not": {
            "type": "object"
          }
        }
      }
    },
    {
      "move": {
        "from": "/xml",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-xml"
            ]
          }
        },
        "optional": true,
        "when": {
          "not": {
            "type": "object"
          }
        }
      }
    }
  ]
}
