{
  "name": "prefix_promoted_openapi_3_1_keywords",
  "match": {
    "all": [
      {
        "call": {
          "name": "schema:in-vocabulary",
          "args": [
            "https://json-schema.org/draft/2020-12/vocab/core"
          ]
        }
      },
      {
        "not": {
          "call": {
            "name": "schema:in-vocabulary",
            "args": [
              "https://spec.openapis.org/oas/3.1/vocab/base",
              "https://spec.openapis.org/oas/3.2/vocab/base"
            ]
          }
        }
      },
      {
        "type": "object"
      },
      {
        "call": {
          "name": "convert:promoted-keyword-is-author-data",
          "args": [
            "https://spec.openapis.org/oas/3.1/dialect/base"
          ]
        }
      },
      {
        "any": [
          {
            "all": [
              {
                "has": "example"
              },
              {
                "not": {
                  "call": {
                    "name": "convert:setting",
                    "args": [
                      "from-openapi-3-0"
                    ]
                  }
                }
              }
            ]
          },
          {
            "all": [
              {
                "has": "discriminator"
              },
              {
                "any": [
                  {
                    "not": {
                      "call": {
                        "name": "convert:setting",
                        "args": [
                          "from-openapi-3-0"
                        ]
                      }
                    }
                  },
                  {
                    "member": {
                      "key": "discriminator",
                      "match": {
                        "not": {
                          "type": "object"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "all": [
              {
                "has": "externalDocs"
              },
              {
                "any": [
                  {
                    "not": {
                      "call": {
                        "name": "convert:setting",
                        "args": [
                          "from-openapi-3-0"
                        ]
                      }
                    }
                  },
                  {
                    "member": {
                      "key": "externalDocs",
                      "match": {
                        "not": {
                          "type": "object"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "all": [
              {
                "has": "xml"
              },
              {
                "any": [
                  {
                    "not": {
                      "call": {
                        "name": "convert:setting",
                        "args": [
                          "from-openapi-3-0"
                        ]
                      }
                    }
                  },
                  {
                    "member": {
                      "key": "xml",
                      "match": {
                        "not": {
                          "type": "object"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "build": [
    {
      "move": {
        "from": "/example",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-example"
            ]
          }
        },
        "optional": true,
        "when": {
          "not": {
            "call": {
              "name": "convert:setting",
              "args": [
                "from-openapi-3-0"
              ]
            }
          }
        }
      }
    },
    {
      "move": {
        "from": "/discriminator",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-discriminator"
            ]
          }
        },
        "optional": true,
        "when": {
          "any": [
            {
              "not": {
                "call": {
                  "name": "convert:setting",
                  "args": [
                    "from-openapi-3-0"
                  ]
                }
              }
            },
            {
              "not": {
                "type": "object"
              }
            }
          ]
        }
      }
    },
    {
      "move": {
        "from": "/externalDocs",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-externalDocs"
            ]
          }
        },
        "optional": true,
        "when": {
          "any": [
            {
              "not": {
                "call": {
                  "name": "convert:setting",
                  "args": [
                    "from-openapi-3-0"
                  ]
                }
              }
            },
            {
              "not": {
                "type": "object"
              }
            }
          ]
        }
      }
    },
    {
      "move": {
        "from": "/xml",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-xml"
            ]
          }
        },
        "optional": true,
        "when": {
          "any": [
            {
              "not": {
                "call": {
                  "name": "convert:setting",
                  "args": [
                    "from-openapi-3-0"
                  ]
                }
              }
            },
            {
              "not": {
                "type": "object"
              }
            }
          ]
        }
      }
    }
  ]
}
