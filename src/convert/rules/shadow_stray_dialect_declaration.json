{
  "name": "shadow_stray_dialect_declaration",
  "match": {
    "all": [
      {
        "type": "object"
      },
      {
        "member": {
          "key": "$schema",
          "match": {
            "type": "string"
          }
        }
      },
      {
        "not": {
          "call": {
            "name": "convert:at-root"
          }
        }
      },
      {
        "not": {
          "call": {
            "name": "convert:at-resource-root"
          }
        }
      }
    ]
  },
  "build": [
    {
      "move": {
        "from": "/$schema",
        "to": {
          "call": {
            "name": "convert:shadow-pointer",
            "args": [
              "$self",
              "$$schema"
            ]
          }
        }
      }
    }
  ]
}
