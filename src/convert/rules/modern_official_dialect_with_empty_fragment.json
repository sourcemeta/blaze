{
  "name": "modern_official_dialect_with_empty_fragment",
  "match": {
    "all": [
      {
        "type": "object"
      },
      {
        "member": {
          "key": "$schema",
          "bind": "$dialect",
          "match": {
            "enum": [
              "https://json-schema.org/draft/2019-09/hyper-schema#",
              "https://json-schema.org/draft/2019-09/schema#",
              "https://json-schema.org/draft/2020-12/hyper-schema#",
              "https://json-schema.org/draft/2020-12/schema#"
            ]
          }
        }
      }
    ]
  },
  "build": [
    {
      "set": {
        "$schema": {
          "lookup": {
            "key": "$dialect",
            "table": {
              "https://json-schema.org/draft/2019-09/schema#": "https://json-schema.org/draft/2019-09/schema",
              "https://json-schema.org/draft/2019-09/hyper-schema#": "https://json-schema.org/draft/2019-09/hyper-schema",
              "https://json-schema.org/draft/2020-12/schema#": "https://json-schema.org/draft/2020-12/schema",
              "https://json-schema.org/draft/2020-12/hyper-schema#": "https://json-schema.org/draft/2020-12/hyper-schema"
            }
          }
        }
      }
    }
  ]
}
