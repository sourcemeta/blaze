{
  "name": "openapi_official_dialect_with_date",
  "match": {
    "all": [
      {
        "type": "object"
      },
      {
        "member": {
          "key": "$schema",
          "bind": "$dialect",
          "match": {
            "enum": [
              "https://spec.openapis.org/oas/3.1/dialect/2024-10-25",
              "https://spec.openapis.org/oas/3.1/dialect/2024-10-25#",
              "https://spec.openapis.org/oas/3.1/dialect/2024-11-10",
              "https://spec.openapis.org/oas/3.1/dialect/2024-11-10#"
            ]
          }
        }
      }
    ]
  },
  "build": [
    {
      "set": {
        "$schema": {
          "lookup": {
            "key": "$dialect",
            "table": {
              "https://spec.openapis.org/oas/3.1/dialect/2024-10-25": "https://spec.openapis.org/oas/3.1/dialect/base",
              "https://spec.openapis.org/oas/3.1/dialect/2024-10-25#": "https://spec.openapis.org/oas/3.1/dialect/base",
              "https://spec.openapis.org/oas/3.1/dialect/2024-11-10": "https://spec.openapis.org/oas/3.1/dialect/base",
              "https://spec.openapis.org/oas/3.1/dialect/2024-11-10#": "https://spec.openapis.org/oas/3.1/dialect/base"
            }
          }
        }
      }
    }
  ]
}
