        {
          "move": {
            "from": "/definitions",
            "to": "/$defs"
          }
        }
      ],
      "if-current": {
        "all": [
          {
            "call": {
              "name": "schema:in-vocabulary",
              "args": [
                "https://json-schema.org/draft/2020-12/vocab/core",
                "https://json-schema.org/draft/2019-09/vocab/core"
              ]
            }
          },
          {
            "type": "object"
          },
          {
            "has": "definitions"
          },
          {
            "not": {
              "has": "$defs"
            }
          }
        ]
      }
    },
    {
      "group": [
        {
          "distribute": {
            "from": "$deps",
            "before": "dependencies",
            "prune-empty": true,
            "cases": [
              {
                "when": {
                  "type": [
                    "object",
                    "boolean"
                  ]
                },
                "to": "/dependentSchemas/$key"
              },
              {
                "when": {
                  "type": "array"
                },
                "to": "/dependentRequired/$key"
              }
            ]
          }
        }
      ],
      "if-current": {
        "all": [
          {
            "call": {
              "name": "schema:in-vocabulary",
              "args": [
                "https://json-schema.org/draft/2020-12/vocab/applicator",
                "https://json-schema.org/draft/2019-09/vocab/applicator"
              ]
            }
          },
          {
            "type": "object"
          },
          {
            "not": {
              "has": [
                "dependentSchemas"
              ]
            }
          },
          {
            "not": {
              "has": [
                "dependentRequired"
              ]
            }
          },
          {
            "member": {
              "key": "dependencies",
              "bind": "$deps",
              "match": {
                "type": "object",
                "members": {
                  "type": [
                    "array",
                    "object",
                    "boolean"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "group": [
        {
          "set": {
            "const": "$only"
          },
          "before": "enum"
        },
        {
          "erase": "enum"
        }
      ],
      "if-current": {
        "all": [
          {
            "call": {
              "name": "schema:in-vocabulary",
              "args": [
                "https://json-schema.org/draft/2020-12/vocab/validation",
                "https://json-schema.org/draft/2019-09/vocab/validation",
                "http://json-schema.org/draft-07/schema#",
                "http://json-schema.org/draft-06/schema#"
              ]
            }
          },
          {
            "type": "object"
          },
          {
            "not": {
              "has": "const"
            }
          },
          {
            "member": {
              "key": "enum",
              "match": {
                "type": "array",
                "size": 1,
                "some-item": {
                  "bind": "$only"
                }
              }
            }
          }
        ]
      }
    },
    {
      "group": [
        {
          "replace": true
        }
      ],
      "if-current": {
        "all": [
          {
            "call": {
              "name": "schema:in-vocabulary",
              "args": [
                "https://json-schema.org/draft/2020-12/vocab/core",
                "https://json-schema.org/draft/2019-09/vocab/core",
                "http://json-schema.org/draft-07/schema#",
                "http://json-schema.org/draft-06/schema#",
                "http://json-schema.org/draft-04/schema#"
              ]
            }
          },
          {
            "type": "object"
          },
          {
            "empty": true
          },
          {
            "not": {
              "call": {
                "name": "convert:at-root"
              }
            }
          }
        ]
      }
    }
  ],
  "bump": {
    "dialect": "https://spec.openapis.org/oas/3.2/dialect/2025-09-17",
    "at-declaration-only": true,
    "only-when": {
      "all": [
        {
          "call": {
            "name": "schema:in-vocabulary",
            "args": [
              "https://spec.openapis.org/oas/3.1/vocab/base"
            ]
          }
        },
        {
          "not": {
            "call": {
              "name": "schema:in-vocabulary",
              "args": [
                "https://spec.openapis.org/oas/3.2/vocab/base"
              ]
            }
          }
        }
      ]
    }
  },
  "queries": {
    "$marker-says-nothing": {
      "name": "convert:marker-says-nothing"
    }
  },
  "writes-outside-itself": true
}
