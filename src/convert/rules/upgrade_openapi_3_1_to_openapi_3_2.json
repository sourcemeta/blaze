{
  "name": "upgrade_openapi_3_1_to_openapi_3_2",
  "match": {
    "all": [
      {
        "call": {
          "name": "schema:in-vocabulary",
          "args": [
            "https://spec.openapis.org/oas/3.1/vocab/base"
          ]
        }
      },
      {
        "not": {
          "call": {
            "name": "schema:in-vocabulary",
            "args": [
              "https://spec.openapis.org/oas/3.2/vocab/base"
            ]
          }
        }
      },
      {
        "type": "object"
      },
      {
        "all": [
          {
            "call": {
              "name": "convert:at-resource-root"
            }
          },
          {
            "any": [
              {
                "call": {
                  "name": "convert:at-root"
                }
              },
              {
                "has": "$schema"
              }
            ]
          }
        ]
      }
    ]
  },
  "build": [
    {
      "erase": "x-sourcemeta-dialect-override-subschema",
      "optional": true,
      "when": {
        "call": {
          "name": "convert:names-ladder-dialect",
          "args": [
            "$term"
          ]
        }
      }
    },
    {
      "set": {
        "$schema": "https://spec.openapis.org/oas/3.2/dialect/2025-09-17"
      },
      "first": true
    }
  ]
}
