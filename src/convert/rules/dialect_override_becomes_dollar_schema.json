{
  "name": "dialect_override_becomes_dollar_schema",
  "match": {
    "all": [
      {
        "type": "object"
      },
      {
        "member": {
          "key": "x-sourcemeta-dialect-override-subschema",
          "bind": "$marker"
        }
      },
      {
        "call": {
          "name": "convert:is-own-dialect-override",
          "args": [
            "$marker"
          ]
        }
      },
      {
        "any": [
          {
            "ref": "at-dialect-declaration"
          },
          {
            "binding": {
              "name": "$marker-says-nothing",
              "match": {
                "const": true
              }
            }
          }
        ]
      }
    ]
  },
  "build": [
    {
      "erase": "x-sourcemeta-dialect-override-subschema"
    },
    {
      "set": {
        "$schema": "$marker"
      },
      "first": true,
      "if": {
        "all": [
          {
            "not": {
              "has": "$schema"
            }
          },
          {
            "ref": "at-dialect-declaration"
          }
        ]
      }
    }
  ],
  "queries": {
    "$marker-says-nothing": {
      "name": "convert:marker-says-nothing"
    }
  }
}
