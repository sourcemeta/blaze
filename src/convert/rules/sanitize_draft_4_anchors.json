{
  "name": "sanitize_draft_4_anchors",
  "writes-outside-itself": true,
  "match": {
    "all": [
      {
        "type": "object"
      },
      {
        "call": {
          "name": "convert:at-root"
        }
      },
      {
        "binding": {
          "name": "$sanitized",
          "match": {
            "type": "object"
          }
        }
      }
    ]
  },
  "build": [
    {
      "replace": "$sanitized"
    }
  ],
  "queries": {
    "$sanitized": {
      "name": "convert:sanitized-draft-4-anchors"
    }
  }
}
