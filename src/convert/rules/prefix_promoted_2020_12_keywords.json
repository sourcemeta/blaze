{
  "name": "prefix_promoted_2020_12_keywords",
  "match": {
    "all": [
      {
        "call": {
          "name": "schema:in-vocabulary",
          "args": [
            "https://json-schema.org/draft/2019-09/vocab/core"
          ]
        }
      },
      {
        "type": "object"
      },
      {
        "call": {
          "name": "convert:promoted-keyword-is-author-data",
          "args": [
            "https://json-schema.org/draft/2020-12/schema"
          ]
        }
      },
      {
        "any": [
          {
            "has": "prefixItems"
          },
          {
            "has": "$dynamicAnchor"
          },
          {
            "has": "$dynamicRef"
          }
        ]
      }
    ]
  },
  "build": [
    {
      "move": {
        "from": "/prefixItems",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-prefixItems"
            ]
          }
        },
        "optional": true
      }
    },
    {
      "move": {
        "from": "/$dynamicAnchor",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-$dynamicAnchor"
            ]
          }
        },
        "optional": true
      }
    },
    {
      "move": {
        "from": "/$dynamicRef",
        "to": {
          "call": {
            "name": "convert:free-pointer",
            "args": [
              "$self",
              "x-$dynamicRef"
            ]
          }
        },
        "optional": true
      }
    }
  ]
}
