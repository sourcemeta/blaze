# Every rule this module applies, read from the JSON it is written in and
# substituted into `rules.in.h`, so that a rule is data on disk and a string
# by the time the compiler sees it

if(NOT CONVERT_RULES_INPUT)
  message(FATAL_ERROR "Missing CONVERT_RULES_INPUT")
endif()
if(NOT CONVERT_RULES_OUTPUT)
  message(FATAL_ERROR "Missing CONVERT_RULES_OUTPUT")
endif()
if(NOT CONVERT_RULES_DIRECTORY)
  message(FATAL_ERROR "Missing CONVERT_RULES_DIRECTORY")
endif()

file(READ "${CONVERT_RULES_DIRECTORY}/definitions_to_defs.json" DEFINITIONS_TO_DEFS)
file(READ "${CONVERT_RULES_DIRECTORY}/dependencies_to_dependent.json" DEPENDENCIES_TO_DEPENDENT)
file(READ "${CONVERT_RULES_DIRECTORY}/dialect_override_becomes_dollar_schema.json" DIALECT_OVERRIDE_BECOMES_DOLLAR_SCHEMA)
file(READ "${CONVERT_RULES_DIRECTORY}/draft_official_dialect_with_https.json" DRAFT_OFFICIAL_DIALECT_WITH_HTTPS)
file(READ "${CONVERT_RULES_DIRECTORY}/empty_object_as_true.json" EMPTY_OBJECT_AS_TRUE)
file(READ "${CONVERT_RULES_DIRECTORY}/enum_to_const.json" ENUM_TO_CONST)
file(READ "${CONVERT_RULES_DIRECTORY}/official_dialect_spelling.json" OFFICIAL_DIALECT_SPELLING)
file(READ "${CONVERT_RULES_DIRECTORY}/prefix_promoted_2020_12_keywords.json" PREFIX_PROMOTED_2020_12_KEYWORDS)
file(READ "${CONVERT_RULES_DIRECTORY}/prefix_promoted_draft_2019_09_keywords.json" PREFIX_PROMOTED_DRAFT_2019_09_KEYWORDS)
file(READ "${CONVERT_RULES_DIRECTORY}/prefix_promoted_draft_4_keywords.json" PREFIX_PROMOTED_DRAFT_4_KEYWORDS)
file(READ "${CONVERT_RULES_DIRECTORY}/prefix_promoted_draft_6_keywords.json" PREFIX_PROMOTED_DRAFT_6_KEYWORDS)
file(READ "${CONVERT_RULES_DIRECTORY}/prefix_promoted_draft_7_keywords.json" PREFIX_PROMOTED_DRAFT_7_KEYWORDS)
file(READ "${CONVERT_RULES_DIRECTORY}/prefix_promoted_openapi_3_1_keywords.json" PREFIX_PROMOTED_OPENAPI_3_1_KEYWORDS)
file(READ "${CONVERT_RULES_DIRECTORY}/sanitize_draft_4_anchors.json" SANITIZE_DRAFT_4_ANCHORS)
file(READ "${CONVERT_RULES_DIRECTORY}/shadow_stray_dialect_declaration.json" SHADOW_STRAY_DIALECT_DECLARATION)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_2019_09_to_2020_12.json" UPGRADE_2019_09_TO_2020_12)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_2020_12_to_openapi_3_1.json" UPGRADE_2020_12_TO_OPENAPI_3_1)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_draft_3_to_draft_4.json" UPGRADE_DRAFT_3_TO_DRAFT_4)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_draft_4_to_draft_6.json" UPGRADE_DRAFT_4_TO_DRAFT_6)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_draft_6_to_draft_7.json" UPGRADE_DRAFT_6_TO_DRAFT_7)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_draft_7_to_draft_2019_09.json" UPGRADE_DRAFT_7_TO_DRAFT_2019_09)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_openapi_3_0_to_draft_4.json" UPGRADE_OPENAPI_3_0_TO_DRAFT_4)
file(READ "${CONVERT_RULES_DIRECTORY}/upgrade_openapi_3_1_to_openapi_3_2.json" UPGRADE_OPENAPI_3_1_TO_OPENAPI_3_2)

# A rule that is not valid JSON would otherwise only fail once the module is
# asked to convert something
foreach(CONVERT_RULE
    DEFINITIONS_TO_DEFS
    DEPENDENCIES_TO_DEPENDENT
    DIALECT_OVERRIDE_BECOMES_DOLLAR_SCHEMA
    DRAFT_OFFICIAL_DIALECT_WITH_HTTPS
    EMPTY_OBJECT_AS_TRUE
    ENUM_TO_CONST
    OFFICIAL_DIALECT_SPELLING
    PREFIX_PROMOTED_2020_12_KEYWORDS
    PREFIX_PROMOTED_DRAFT_2019_09_KEYWORDS
    PREFIX_PROMOTED_DRAFT_4_KEYWORDS
    PREFIX_PROMOTED_DRAFT_6_KEYWORDS
    PREFIX_PROMOTED_DRAFT_7_KEYWORDS
    PREFIX_PROMOTED_OPENAPI_3_1_KEYWORDS
    SANITIZE_DRAFT_4_ANCHORS
    SHADOW_STRAY_DIALECT_DECLARATION
    UPGRADE_2019_09_TO_2020_12
    UPGRADE_2020_12_TO_OPENAPI_3_1
    UPGRADE_DRAFT_3_TO_DRAFT_4
    UPGRADE_DRAFT_4_TO_DRAFT_6
    UPGRADE_DRAFT_6_TO_DRAFT_7
    UPGRADE_DRAFT_7_TO_DRAFT_2019_09
    UPGRADE_OPENAPI_3_0_TO_DRAFT_4
    UPGRADE_OPENAPI_3_1_TO_OPENAPI_3_2)
  string(JSON CONVERT_RULE_LENGTH ERROR_VARIABLE CONVERT_RULE_ERROR
    LENGTH "${${CONVERT_RULE}}")
  if(CONVERT_RULE_ERROR)
    message(FATAL_ERROR
      "Invalid JSON in ${CONVERT_RULE}: ${CONVERT_RULE_ERROR}")
  endif()
endforeach()

# Editing a rule has to regenerate the header, which only happens if CMake
# knows the rules are inputs to the configure step that read them
file(GLOB CONVERT_RULE_FILES "${CONVERT_RULES_DIRECTORY}/*.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  ${CONVERT_RULE_FILES})

configure_file("${CONVERT_RULES_INPUT}" "${CONVERT_RULES_OUTPUT}" @ONLY)
