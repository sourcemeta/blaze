{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:sourcemeta.com,2026:table-format/2",
  "title": "Table format",
  "description": "A description of data for documentation: which properties there are, what may go in each, and which are required. Independent of the schema language it was converted from",
  "examples": [
    {
      "$schema": "tag:sourcemeta.com,2026:table-format/2",
      "title": "Order",
      "language": "https://json-schema.org/draft/2020-12/schema",
      "root": {
        "kind": "object",
        "properties": [
          {
            "name": "buyer",
            "value": {
              "kind": "ref",
              "ref": "/$defs/party"
            }
          }
        ]
      },
      "shapes": [
        {
          "id": "/$defs/party",
          "name": "party",
          "value": {
            "kind": "object",
            "properties": [
              {
                "name": "name",
                "value": {
                  "kind": "string"
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "x-lint-exclude": "simple_properties_identifiers",
  "type": "object",
  "required": [ "$schema", "title", "language", "root" ],
  "properties": {
    "$schema": {
      "description": "The name of this format and its version",
      "const": "tag:sourcemeta.com,2026:table-format/2"
    },
    "title": {
      "description": "The title of what is described",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "description": "The address of the schema language, and version, the document was converted from. For JSON Schema, the dialect",
      "examples": [
        "https://json-schema.org/draft/2020-12/schema",
        "https://avro.apache.org/docs/1.11.1/specification/"
      ],
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
      "minLength": 1
    },
    "root": {
      "description": "What a whole document holds",
      "$ref": "#/$defs/value"
    },
    "shapes": {
      "description": "Values described once and referred to by id, most used first. Absent when there are none",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shape"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "shape": {
      "type": "object",
      "required": [ "id", "name", "value" ],
      "properties": {
        "id": {
          "description": "Unique among the shapes. A `ref` equal to it means this shape",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "description": "The name the shape is declared under, or the last part of its id",
          "type": "string",
          "minLength": 1
        },
        "section": {
          "description": "A heading to list the shape under, when the author filed shapes in groups",
          "type": "string",
          "minLength": 1
        },
        "usedAt": {
          "description": "JSON Pointers into this document to every place that refers to this shape",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "string"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "format",
                "pattern",
                "length",
                "content",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "format",
                "range",
                "multipleOf",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "integer"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "format",
                "range",
                "multipleOf",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "object"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "properties",
                "patternProperties",
                "otherProperties",
                "closed",
                "keys",
                "propertyCount",
                "discriminator",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "array"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "item",
                "slots",
                "length",
                "unique",
                "contains",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [ "values" ],
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "values"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [ "options" ],
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "options",
                "overlap",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ref"
              }
            }
          },
          "then": {
            "required": [ "ref" ],
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "ref"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external"
              }
            }
          },
          "then": {
            "required": [ "href" ],
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "href"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "any"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "never"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions"
              ]
            }
          }
        }
      ],
      "required": [ "kind" ],
      "properties": {
        "kind": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "null",
            "object",
            "array",
            "enum",
            "choice",
            "ref",
            "external",
            "any",
            "never"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "description": "The value assumed when none is given"
        },
        "examples": {
          "type": "array",
          "minItems": 1
        },
        "deprecated": {
          "const": true
        },
        "nullable": {
          "description": "null is also allowed",
          "const": true
        },
        "access": {
          "description": "`read`: supplied by the system, not written by you. `write`: written by you, never returned",
          "enum": [ "read", "write" ]
        },
        "also": {
          "description": "Values the data must also match",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "not": {
          "description": "A value the data must not match",
          "$ref": "#/$defs/value"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "otherTypesAllowed": {
          "description": "Data of a JSON type this value is not about (for a choice, that no form is about) also passes, and the rules of this kind do not apply to it",
          "const": true
        },
        "format": {
          "description": "A label from the source language, such as email or date-time. Whether data is checked against it depends on that language; the format does not state it as a rule",
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "description": "An ECMA-262 regular expression, exactly as written in the source. The text matches when the pattern is found anywhere in it, unless the pattern is anchored",
          "type": "string"
        },
        "length": {
          "description": "For a string, characters. For an array, entries",
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "content": {
          "description": "What the text holds. It describes the text; it is not a rule the data is checked against",
          "type": "object",
          "minProperties": 1,
          "properties": {
            "mediaType": {
              "type": "string"
            },
            "encoding": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        },
        "range": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "minExclusive": {
              "const": true
            },
            "maxExclusive": {
              "const": true
            }
          },
          "additionalProperties": false,
          "dependentRequired": {
            "minExclusive": [ "min" ],
            "maxExclusive": [ "max" ]
          }
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "patternProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [ "pattern", "value" ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/value"
              }
            },
            "additionalProperties": false
          }
        },
        "otherProperties": {
          "description": "What every property that is not named holds",
          "$ref": "#/$defs/value"
        },
        "closed": {
          "description": "Every property must be named",
          "const": true
        },
        "keys": {
          "description": "What every property name must be",
          "$ref": "#/$defs/value"
        },
        "propertyCount": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "discriminator": {
          "type": "object",
          "required": [ "property", "cases" ],
          "properties": {
            "property": {
              "type": "string"
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [ "is", "ref" ],
                "properties": {
                  "is": true,
                  "ref": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "item": {
          "description": "What every entry holds, or every entry after the slots",
          "$ref": "#/$defs/value"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "unique": {
          "const": true
        },
        "contains": {
          "type": "object",
          "required": [ "value", "min" ],
          "properties": {
            "value": {
              "$ref": "#/$defs/value"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "values": {
          "type": "array",
          "minItems": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "overlap": {
          "description": "More than one form may match. Without it, exactly one does",
          "const": true
        },
        "ref": {
          "description": "The id of a shape, or \"\" for the root",
          "type": "string"
        },
        "href": {
          "description": "The other document: an absolute address when the source gives one, otherwise the reference as written",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "property": {
      "type": "object",
      "required": [ "name" ],
      "properties": {
        "name": {
          "type": "string"
        },
        "required": {
          "description": "The property must be present. Absent means it may be left out",
          "const": true
        },
        "value": {
          "description": "What may go in the property. Absent means nothing is said about it here",
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "anyOf": [
        {
          "required": [ "then" ]
        },
        {
          "required": [ "otherwise" ]
        }
      ],
      "required": [ "when" ],
      "properties": {
        "when": {
          "$ref": "#/$defs/value"
        },
        "then": {
          "$ref": "#/$defs/value"
        },
        "otherwise": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    }
  }
}
