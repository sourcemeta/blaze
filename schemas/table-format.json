{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:sourcemeta.com,2026:table-format/2",
  "title": "Table format",
  "description": "A description of data for documentation: which properties there are, what may go in each, and which are required. Independent of the schema language it was converted from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "title",
    "language",
    "root"
  ],
  "properties": {
    "$schema": {
      "const": "tag:sourcemeta.com,2026:table-format/2",
      "description": "The name of this format and its version."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The title of what is described."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
      "description": "The address of the schema language, and version, the document was converted from. For JSON Schema, the dialect.",
      "examples": [
        "https://json-schema.org/draft/2020-12/schema",
        "https://avro.apache.org/docs/1.11.1/specification/"
      ]
    },
    "root": {
      "$ref": "#/$defs/value",
      "description": "What a whole document holds."
    },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shape"
      },
      "description": "Values described once and referred to by id, most used first. Absent when there are none."
    }
  },
  "$defs": {
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique among the shapes. A `ref` equal to it means this shape."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The name the shape is declared under, or the last part of its id."
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "description": "A heading to list the shape under, when the author filed shapes in groups."
        },
        "usedAt": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "JSON Pointers into this document to every place that refers to this shape."
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "value": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "null",
            "object",
            "array",
            "enum",
            "choice",
            "ref",
            "external",
            "any",
            "never"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "description": "The value assumed when none is given."
        },
        "examples": {
          "type": "array",
          "minItems": 1
        },
        "deprecated": {
          "const": true
        },
        "nullable": {
          "const": true,
          "description": "null is also allowed."
        },
        "access": {
          "enum": [
            "read",
            "write"
          ],
          "description": "`read`: supplied by the system, not written by you. `write`: written by you, never returned."
        },
        "also": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          },
          "description": "Values the data must also match."
        },
        "not": {
          "$ref": "#/$defs/value",
          "description": "A value the data must not match."
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "otherTypesAllowed": {
          "const": true,
          "description": "Data of a JSON type this value is not about (for a choice, that no form is about) also passes, and the rules of this kind do not apply to it."
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "description": "A label from the source language, such as email or date-time. Whether data is checked against it depends on that language; the format does not state it as a rule."
        },
        "pattern": {
          "type": "string",
          "description": "An ECMA-262 regular expression, exactly as written in the source. The text matches when the pattern is found anywhere in it, unless the pattern is anchored."
        },
        "length": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "For a string, characters. For an array, entries."
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "What the text holds. It describes the text; it is not a rule the data is checked against.",
          "properties": {
            "mediaType": {
              "type": "string"
            },
            "encoding": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "minExclusive": {
              "const": true
            },
            "maxExclusive": {
              "const": true
            }
          },
          "dependentRequired": {
            "minExclusive": [
              "min"
            ],
            "maxExclusive": [
              "max"
            ]
          }
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "patternProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "value"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        "otherProperties": {
          "$ref": "#/$defs/value",
          "description": "What every property that is not named holds."
        },
        "closed": {
          "const": true,
          "description": "Every property must be named."
        },
        "keys": {
          "$ref": "#/$defs/value",
          "description": "What every property name must be."
        },
        "propertyCount": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "discriminator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "property",
            "cases"
          ],
          "properties": {
            "property": {
              "type": "string"
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "is",
                  "ref"
                ],
                "properties": {
                  "is": {},
                  "ref": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "item": {
          "$ref": "#/$defs/value",
          "description": "What every entry holds, or every entry after the slots."
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "unique": {
          "const": true
        },
        "contains": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "min"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/value"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "values": {
          "type": "array",
          "minItems": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "overlap": {
          "const": true,
          "description": "More than one form may match. Without it, exactly one does."
        },
        "ref": {
          "type": "string",
          "description": "The id of a shape, or \"\" for the root."
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "description": "The other document: an absolute address when the source gives one, otherwise the reference as written."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "string"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "format",
                "pattern",
                "length",
                "content",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "format",
                "range",
                "multipleOf",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "integer"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "format",
                "range",
                "multipleOf",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "null"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "object"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "properties",
                "patternProperties",
                "otherProperties",
                "closed",
                "keys",
                "propertyCount",
                "discriminator",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "array"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "item",
                "slots",
                "length",
                "unique",
                "contains",
                "otherTypesAllowed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enum"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "values"
              ]
            },
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "options",
                "overlap",
                "otherTypesAllowed"
              ]
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ref"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "ref"
              ]
            },
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions",
                "href"
              ]
            },
            "required": [
              "href"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "any"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "never"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "kind",
                "title",
                "description",
                "default",
                "examples",
                "deprecated",
                "nullable",
                "access",
                "also",
                "not",
                "conditions"
              ]
            }
          }
        }
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "required": {
          "const": true,
          "description": "The property must be present. Absent means it may be left out."
        },
        "value": {
          "$ref": "#/$defs/value",
          "description": "What may go in the property. Absent means nothing is said about it here."
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/value"
        },
        "then": {
          "$ref": "#/$defs/value"
        },
        "otherwise": {
          "$ref": "#/$defs/value"
        }
      },
      "anyOf": [
        {
          "required": [
            "then"
          ]
        },
        {
          "required": [
            "otherwise"
          ]
        }
      ]
    }
  }
}
